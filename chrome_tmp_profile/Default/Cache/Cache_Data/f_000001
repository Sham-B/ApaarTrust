/* ==========================================================================
   ApaarTrust Components Library
   Buttons, Status Pills, Cards, Tables, Modals, Drawers, Skeletons, Toasts, etc.
   ========================================================================== */

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  padding: 8px 16px;
  border-radius: var(--radius-sm);
  font-weight: 500;
  font-size: 0.88rem;
  line-height: 1.25;
  border: 1px solid transparent;
  cursor: pointer;
  transition: all var(--transition-fast);
  text-decoration: none;
  white-space: nowrap;
}

.btn:active {
  transform: scale(0.98);
}

.btn:disabled {
  opacity: 0.55;
  cursor: not-allowed;
  pointer-events: none;
}

.btn-primary {
  background-color: var(--navy);
  color: #ffffff;
  border-color: var(--navy);
  box-shadow: var(--shadow-sm);
}

.btn-primary:hover {
  background-color: var(--navy-light);
  border-color: var(--navy-light);
  text-decoration: none;
}

.btn-saffron {
  background-color: var(--saffron);
  color: #ffffff;
  border-color: var(--saffron);
  box-shadow: var(--shadow-sm);
}

.btn-saffron:hover {
  background-color: var(--saffron-dark);
  border-color: var(--saffron-dark);
  text-decoration: none;
}

.btn-secondary {
  background-color: var(--bg-surface);
  color: var(--text-main);
  border-color: var(--border-main);
  box-shadow: var(--shadow-xs);
}

.btn-secondary:hover {
  background-color: var(--bg-hover);
  border-color: var(--border-strong);
  text-decoration: none;
}

.btn-danger {
  background-color: var(--red);
  color: #ffffff;
  border-color: var(--red);
}

.btn-danger:hover {
  background-color: var(--red-dark);
  border-color: var(--red-dark);
  text-decoration: none;
}

.btn-ghost {
  background-color: transparent;
  color: var(--text-muted);
}

.btn-ghost:hover {
  color: var(--text-main);
  background-color: var(--bg-hover);
  text-decoration: none;
}

.btn-sm {
  padding: 5px 10px;
  font-size: 0.8rem;
  gap: var(--space-1);
}

.btn-lg {
  padding: 12px 24px;
  font-size: 1rem;
}

.btn-icon {
  padding: 8px;
  border-radius: var(--radius-sm);
  background: transparent;
  border: 1px solid transparent;
  color: var(--text-muted);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-fast);
}

.btn-icon:hover {
  color: var(--text-main);
  background-color: var(--bg-hover);
}

/* Status Pills (Icon + Word, Color Semantic) */
.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 3px 8px;
  border-radius: var(--radius-full);
  font-size: 0.76rem;
  font-weight: 500;
  line-height: 1.2;
  border: 1px solid transparent;
  white-space: nowrap;
}

.status-pill .icon {
  width: 0.85rem;
  height: 0.85rem;
}

.status-good {
  background-color: var(--status-good-bg);
  color: var(--status-good-text);
  border-color: var(--status-good-border);
}
.status-good .icon { stroke: var(--status-good-icon); }

.status-look {
  background-color: var(--status-look-bg);
  color: var(--status-look-text);
  border-color: var(--status-look-border);
}
.status-look .icon { stroke: var(--status-look-icon); }

.status-problem {
  background-color: var(--status-problem-bg);
  color: var(--status-problem-text);
  border-color: var(--status-problem-border);
}
.status-problem .icon { stroke: var(--status-problem-icon); }

.status-waiting {
  background-color: var(--status-waiting-bg);
  color: var(--status-waiting-text);
  border-color: var(--status-waiting-border);
}
.status-waiting .icon { stroke: var(--status-waiting-icon); }

.status-unavailable {
  background-color: var(--status-unavailable-bg);
  color: var(--status-unavailable-text);
  border-color: var(--status-unavailable-border);
}
.status-unavailable .icon { stroke: var(--status-unavailable-icon); }

/* Cards */
.card {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-xs);
  transition: box-shadow var(--transition-fast), border-color var(--transition-fast);
  overflow: hidden;
}

.card:hover {
  border-color: var(--border-main);
}

.card-header {
  padding: var(--space-4) var(--space-5);
  border-bottom: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
}

.card-header h3 {
  font-size: 1.05rem;
  font-weight: 600;
  margin: 0;
}

.card-body {
  padding: var(--space-5);
}

.card-footer {
  padding: var(--space-3) var(--space-5);
  background-color: var(--bg-subtle);
  border-top: 1px solid var(--border-subtle);
}

/* Stat Cards (Stripe Style with Sparkline) */
.stat-card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: var(--space-4);
  margin-bottom: var(--space-6);
}

.stat-card {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: var(--space-4);
  box-shadow: var(--shadow-xs);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
  overflow: hidden;
  transition: transform var(--transition-fast), box-shadow var(--transition-fast);
}

.stat-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.stat-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-2);
}

.stat-label {
  font-size: 0.85rem;
  color: var(--text-muted);
  font-weight: 500;
}

.stat-card-body {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-3);
}

.stat-value {
  font-size: 1.85rem;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1;
}

.stat-trend {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  font-size: 0.75rem;
  font-weight: 600;
}

.stat-trend.up { color: var(--green); }
.stat-trend.down { color: var(--red); }
.stat-trend.neutral { color: var(--text-muted); }

.sparkline-canvas {
  width: 90px;
  height: 35px;
}

/* Data Table (Stripe & IBM Carbon Inspired) */
.table-container {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-xs);
}

.table-toolbar {
  padding: var(--space-3) var(--space-4);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  border-bottom: 1px solid var(--border-subtle);
  flex-wrap: wrap;
}

.table-search {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  background-color: var(--bg-subtle);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  padding: 4px 10px;
  min-width: 240px;
}

.table-search input {
  border: none;
  background: transparent;
  outline: none;
  color: var(--text-main);
  width: 100%;
}

.table-actions {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.table-wrapper {
  overflow-x: auto;
  max-height: 580px;
}

.data-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  font-size: 0.88rem;
}

.data-table th {
  background-color: var(--bg-subtle);
  color: var(--text-muted);
  font-weight: 600;
  padding: 10px 14px;
  border-bottom: 1px solid var(--border-main);
  position: sticky;
  top: 0;
  z-index: 10;
  white-space: nowrap;
  user-select: none;
}

.data-table th.sortable {
  cursor: pointer;
}

.data-table th.sortable:hover {
  color: var(--text-main);
  background-color: var(--bg-hover);
}

.data-table td {
  padding: 11px 14px;
  border-bottom: 1px solid var(--border-subtle);
  color: var(--text-main);
  vertical-align: middle;
}

.data-table tbody tr:hover {
  background-color: var(--bg-subtle);
}

/* Compact Density */
.data-table.density-compact td {
  padding: 6px 10px;
  font-size: 0.82rem;
}
.data-table.density-compact th {
  padding: 6px 10px;
  font-size: 0.8rem;
}

.table-pagination {
  padding: var(--space-3) var(--space-4);
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid var(--border-subtle);
  background-color: var(--bg-surface);
  font-size: 0.82rem;
  color: var(--text-muted);
}

/* Gauges & Progress Rings */
.gauge-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.gauge-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.85rem;
}

.gauge-bar-track {
  width: 100%;
  height: 8px;
  background-color: var(--bg-subtle);
  border-radius: var(--radius-full);
  overflow: hidden;
  position: relative;
}

.gauge-bar-fill {
  height: 100%;
  border-radius: var(--radius-full);
  transition: width 400ms ease;
}

.gauge-bar-fill.good { background-color: var(--green); }
.gauge-bar-fill.look { background-color: var(--amber); }
.gauge-bar-fill.problem { background-color: var(--red); }

/* GOV.UK Error Summary Block */
.error-summary {
  border-left: 4px solid var(--red);
  background-color: var(--status-problem-bg);
  padding: var(--space-4);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  margin-bottom: var(--space-4);
}

.error-summary h4 {
  color: var(--status-problem-text);
  margin-bottom: var(--space-1);
}

.error-summary ul {
  padding-left: var(--space-4);
  color: var(--status-problem-text);
  font-size: 0.88rem;
}

.error-summary li {
  margin-bottom: var(--space-1);
}

/* Stepper Component */
.stepper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-6);
  position: relative;
}

.stepper::before {
  content: "";
  position: absolute;
  top: 18px;
  left: 30px;
  right: 30px;
  height: 2px;
  background-color: var(--border-subtle);
  z-index: 1;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-1);
  position: relative;
  z-index: 2;
  background-color: var(--bg-page);
  padding: 0 var(--space-2);
}

.step-circle {
  width: 36px;
  height: 36px;
  border-radius: var(--radius-full);
  background-color: var(--bg-surface);
  border: 2px solid var(--border-main);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  font-size: 0.9rem;
  color: var(--text-muted);
  transition: all var(--transition-fast);
}

.step-item.active .step-circle {
  border-color: var(--navy);
  background-color: var(--navy);
  color: #ffffff;
}

.step-item.completed .step-circle {
  border-color: var(--green);
  background-color: var(--green);
  color: #ffffff;
}

.step-title {
  font-size: 0.8rem;
  color: var(--text-muted);
  font-weight: 500;
}

.step-item.active .step-title {
  color: var(--text-main);
  font-weight: 600;
}

/* Modal Backdrop & Window */
.modal-backdrop {
  position: fixed;
  inset: 0;
  background-color: rgba(15, 23, 42, 0.6);
  backdrop-filter: blur(4px);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-4);
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--transition-normal);
}

.modal-backdrop.open {
  opacity: 1;
  pointer-events: auto;
}

.modal-window {
  background-color: var(--bg-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-xl);
  border: 1px solid var(--border-subtle);
  width: 100%;
  max-width: 580px;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transform: translateY(12px) scale(0.97);
  transition: transform var(--transition-normal);
}

.modal-backdrop.open .modal-window {
  transform: translateY(0) scale(1);
}

.modal-header {
  padding: var(--space-4) var(--space-5);
  border-bottom: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modal-body {
  padding: var(--space-5);
  overflow-y: auto;
}

.modal-footer {
  padding: var(--space-3) var(--space-5);
  border-top: 1px solid var(--border-subtle);
  background-color: var(--bg-subtle);
  display: flex;
  justify-content: flex-end;
  gap: var(--space-2);
}

/* Drawer Component (Slide in from Right) */
.drawer-backdrop {
  position: fixed;
  inset: 0;
  background-color: rgba(15, 23, 42, 0.5);
  backdrop-filter: blur(2px);
  z-index: 90;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--transition-normal);
}

.drawer-backdrop.open {
  opacity: 1;
  pointer-events: auto;
}

.drawer-window {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 480px;
  max-width: 90vw;
  background-color: var(--bg-surface);
  border-left: 1px solid var(--border-subtle);
  box-shadow: var(--shadow-xl);
  z-index: 95;
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform var(--transition-normal);
}

.drawer-backdrop.open .drawer-window {
  transform: translateX(0);
}

.drawer-header {
  padding: var(--space-4) var(--space-5);
  border-bottom: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.drawer-body {
  padding: var(--space-5);
  overflow-y: auto;
  flex: 1;
}

/* Toast Container & Notification Item */
.toast-container {
  position: fixed;
  bottom: var(--space-4);
  right: var(--space-4);
  z-index: 120;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  pointer-events: none;
}

.toast {
  pointer-events: auto;
  background-color: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: var(--space-3) var(--space-4);
  box-shadow: var(--shadow-lg);
  display: flex;
  align-items: center;
  gap: var(--space-3);
  min-width: 280px;
  max-width: 420px;
  font-size: 0.88rem;
  color: var(--text-main);
  animation: toastIn 200ms ease forwards;
}

@keyframes toastIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.toast-success { border-left: 4px solid var(--green); }
.toast-warning { border-left: 4px solid var(--amber); }
.toast-error { border-left: 4px solid var(--red); }
.toast-info { border-left: 4px solid var(--blue); }

/* Skeleton Shimmer */
.skeleton {
  background: linear-gradient(90deg, var(--bg-subtle) 25%, var(--bg-hover) 50%, var(--bg-subtle) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: var(--radius-sm);
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* Empty State */
.empty-state {
  text-align: center;
  padding: var(--space-12) var(--space-6);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-state-icon {
  width: 56px;
  height: 56px;
  color: var(--text-subtle);
  margin-bottom: var(--space-3);
}

.empty-state h3 {
  font-size: 1.15rem;
  margin-bottom: var(--space-1);
}

.empty-state p {
  color: var(--text-muted);
  max-width: 400px;
  margin-bottom: var(--space-4);
}

/* Form Controls */
.form-group {
  margin-bottom: var(--space-4);
}

.form-label {
  display: block;
  font-size: 0.82rem;
  font-weight: 500;
  color: var(--text-main);
  margin-bottom: var(--space-1);
}

.form-input, .form-select, .form-textarea {
  width: 100%;
  padding: 8px 12px;
  background-color: var(--bg-surface);
  border: 1px solid var(--border-main);
  border-radius: var(--radius-sm);
  color: var(--text-main);
  font-size: 0.88rem;
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
}

.form-input:focus, .form-select:focus, .form-textarea:focus {
  border-color: var(--blue);
  box-shadow: 0 0 0 3px rgba(21, 101, 192, 0.15);
  outline: none;
}

/* File Dropzone */
.file-dropzone {
  border: 2px dashed var(--border-main);
  border-radius: var(--radius-md);
  padding: var(--space-8);
  text-align: center;
  cursor: pointer;
  background-color: var(--bg-subtle);
  transition: all var(--transition-fast);
}

.file-dropzone:hover, .file-dropzone.dragover {
  border-color: var(--navy);
  background-color: rgba(20, 48, 122, 0.04);
}

/* Command Palette (Linear Style) */
.cmd-palette-box {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-xl);
  width: 100%;
  max-width: 600px;
  overflow: hidden;
}

.cmd-palette-input {
  width: 100%;
  padding: var(--space-4) var(--space-5);
  border: none;
  border-bottom: 1px solid var(--border-subtle);
  background: transparent;
  font-size: 1.05rem;
  color: var(--text-main);
  outline: none;
}

.cmd-palette-results {
  max-height: 360px;
  overflow-y: auto;
  padding: var(--space-2);
}

.cmd-item {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: 10px 14px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  color: var(--text-main);
  font-size: 0.88rem;
  transition: background-color var(--transition-fast);
}

.cmd-item:hover, .cmd-item.selected {
  background-color: var(--bg-hover);
}

/* India State Tile Map Grid */
.state-tile-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(70px, 1fr));
  gap: var(--space-2);
  padding: var(--space-2);
}

.state-tile {
  aspect-ratio: 1;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-subtle);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  padding: 4px;
  transition: all var(--transition-fast);
  user-select: none;
}

.state-tile:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-sm);
  border-color: var(--border-strong);
}

.state-tile .state-code {
  font-weight: 700;
  font-size: 0.85rem;
}

.state-tile .state-badge {
  font-size: 0.65rem;
  font-weight: 600;
  margin-top: 2px;
}

.state-tile.good {
  background-color: var(--status-good-bg);
  color: var(--status-good-text);
  border-color: var(--status-good-border);
}
.state-tile.problem {
  background-color: var(--status-problem-bg);
  color: var(--status-problem-text);
  border-color: var(--status-problem-border);
}
.state-tile.needs_review {
  background-color: var(--status-look-bg);
  color: var(--status-look-text);
  border-color: var(--status-look-border);
}
.state-tile.idle {
  background-color: var(--bg-subtle);
  color: var(--text-subtle);
}

/* Copilot Drawer Assistant */
.copilot-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}

.copilot-chip {
  background-color: var(--bg-subtle);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-full);
  padding: 4px 10px;
  font-size: 0.76rem;
  color: var(--text-main);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.copilot-chip:hover {
  border-color: var(--saffron);
  color: var(--saffron);
}

.copilot-message {
  padding: var(--space-3);
  border-radius: var(--radius-md);
  margin-bottom: var(--space-3);
  font-size: 0.88rem;
  line-height: 1.5;
}

.copilot-message.user {
  background-color: var(--bg-hover);
  margin-left: var(--space-6);
}

.copilot-message.assistant {
  background-color: var(--bg-subtle);
  border: 1px solid var(--border-subtle);
  margin-right: var(--space-6);
}

.copilot-citation {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 0.72rem;
  font-family: var(--font-mono);
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  padding: 2px 6px;
  margin-top: var(--space-2);
  color: var(--text-muted);
}
